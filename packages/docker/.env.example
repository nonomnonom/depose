# Copy to .env and fill every required value before `pnpm up:prod`.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Database
POSTGRES_USER=depose
POSTGRES_PASSWORD=change-me
POSTGRES_DB=depose

# Application
NODE_ENV=production
SERVER_PORT=3000
FRONTEND_PORT=4173

# Composed services
DATABASE_URL=postgresql://depose:change-me@db:5432/depose
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333

# Auth (required in production; 32+ characters)
BETTER_AUTH_URL=https://depose.example.com
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=https://depose.example.com
AUTH_ALLOW_SELF_SIGNUP=true
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Tenancy
BASE_DOMAIN=depose.example.com
TENANCY_MODE=single
TRUST_PROXY=true

# Storage (local filesystem only in this build). docker-compose pins this to
# /data/storage on the shared `storage-data` volume for server and worker.
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/data/storage

# Mail ("file" writes .eml files; use "smtp" in production)
MAIL_TRANSPORT=file
MAIL_DIRECTORY=var/mail
MAIL_FROM=Depose <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# BYOK AI provider keys are encrypted at rest with this key (required before adding a provider)
AI_SECRET_ENCRYPTION_KEY=

# Operator-owned pipeline routes (optional, disabled when base URLs are empty)
DECISION_PROVIDER=typesafe
DECISION_BASE_URL=
DECISION_API_KEY=
EXTRACTION_BASE_URL=
EXTRACTION_API_KEY=
EXTRACTION_MODEL=extract

# Retrieval (optional; falls back to lexical search without these)
VECTOR_SEARCH_ENABLED=true
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Outbound integrations: block private/loopback targets in production
ALLOW_PRIVATE_OUTBOUND_URLS=false

# docker-compose overrides this per service: false on `server`, true on `worker`.
# Only set it when running the processes outside compose.
WORKER_ENABLED=true

# Frontend
VITE_API_BASE_URL=https://depose.example.com/api
