# Database
POSTGRES_USER=depose
POSTGRES_PASSWORD=changeme
POSTGRES_DB=depose

# Application
NODE_ENV=production

# Server
DATABASE_URL=postgresql://${POSTGRES_USER:-depose}:${POSTGRES_PASSWORD:-changeme}@db:5432/${POSTGRES_DB:-depose}
REDIS_HOST=redis
REDIS_PORT=6379
NODE_PORT=3000

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api

# Ports
SERVER_PORT=3000
FRONTEND_PORT=4173

# Optional
ENCRYPTION_KEY=
APP_SECRET=

# Mail
MAIL_TRANSPORT=
MAIL_DIRECTORY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Storage
STORAGE_TYPE=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Cron / worker
DISABLE_CRON_JOBS_REGISTRATION=
CRON_JOB_INTERVAL=
