FROM node:24-alpine AS base

RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
RUN apk add --no-cache libc6-compat vips-dev && rm -rf /var/cache/apk/*

WORKDIR /app

FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/server/package.json packages/server/package.json
COPY packages/frontend/package.json packages/frontend/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/docker/package.json packages/docker/package.json

RUN pnpm install --frozen-lockfile

FROM base AS build

COPY --from=deps /app/node_modules /app/node_modules
COPY packages packages
COPY . .

WORKDIR /app/packages/server
RUN pnpm install --frozen-lockfile --filter server
RUN pnpm --filter server build

FROM base AS runner

ENV NODE_ENV=production
WORKDIR /app

# Runtime dependencies only are already resolved by pnpm; copy the workspace
# node_modules so the server's symlinked packages stay intact.
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/server/node_modules ./packages/server/node_modules
COPY --from=build /app/packages/server/dist ./packages/server/dist
COPY --from=build /app/packages/server/drizzle ./packages/server/drizzle
COPY packages/server/package.json ./packages/server/package.json

WORKDIR /app/packages/server

# Uploaded documents are written under the local storage path; the runtime
# user needs to own it, otherwise every ingest fails with EACCES.
RUN mkdir -p /app/packages/server/.local-storage \
  && chown -R node:node /app/packages/server

EXPOSE 3000
USER node

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD wget -q -O - "http://127.0.0.1:${PORT:-3000}/api/health/ready" > /dev/null || exit 1

CMD ["node", "dist/main.js"]
