# Server
NODE_ENV=development
PORT=3000
# Serves /api/docs and /api/v1/openapi.json
OPENAPI_ENABLED=true

# Database and jobs (both required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/depose
REDIS_URL=redis://localhost:6379

# Host-based tenancy
TENANCY_MODE=single
BASE_DOMAIN=localhost
CUSTOM_DOMAIN_TARGET=
CUSTOM_DOMAIN_IP=
CUSTOM_DOMAIN_LIMIT=5
TRUST_PROXY=false
TLS_MODE=external
SSL_KEY_PATH=
SSL_CERT_PATH=

# Storage (local only in this build; mount a persistent volume in production)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=.local-storage

# Outbound integrations (AI providers, webhooks, MCP servers) are supplied by firm
# admins. auto = reject private/loopback targets in production, allow in dev/test.
ALLOW_PRIVATE_OUTBOUND_URLS=auto

# Better Auth
# Required in production (>= 32 characters).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:5173
AUTH_SSO_ENABLED=false
AUTH_FORCE_SSO=false
AUTH_ALLOW_SELF_SIGNUP=true
AUTH_REQUIRE_ADMIN_APPROVAL=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Mail ("file" writes .eml to var/mail; "smtp" delivers)
MAIL_TRANSPORT=file
MAIL_FROM=Depose <no-reply@localhost>
MAIL_DIRECTORY=var/mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Model gateway (spec 48)
# Key used only to encrypt firm BYOK provider keys at rest.
# 32 bytes, base64. Required before a firm can add a provider.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_SECRET_ENCRYPTION_KEY=
MODEL_GATEWAY_TIMEOUT_MS=60000
MODEL_GATEWAY_MAX_RETRIES=2
MODEL_GATEWAY_STRICT_CAPABILITY=true

# Completion is BYOK per firm: there is no instance AI_API_KEY / AI_MODEL.
# Add providers in Firm settings > AI providers.

# Decision route: System One typed questions (operator-owned, spec 48)
# DECISION_PROVIDER=typesafe -> {BASE}/systemone
# DECISION_PROVIDER=openrouter -> {BASE}/alpha/decisions
# Never replace with a completion model.
DECISION_PROVIDER=typesafe
DECISION_BASE_URL=
DECISION_API_KEY=
DECISION_MODEL=jev-latest
DECISION_THRESHOLD=0.8

# Retrieval and vector index (spec 22)
# Qdrant is the vector index; Postgres remains the source of truth.
# Without these variables search still works lexically with a vector_unavailable warning.
VECTOR_SEARCH_ENABLED=true
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=depose
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Fact extraction pipeline (operator-owned, spec 16/48)
# OpenAI-compatible extraction endpoint. Without a base URL, extraction jobs
# fail EXTRACTION_NOT_CONFIGURED rather than inventing facts.
EXTRACTION_PROVIDER=openai-compatible
EXTRACTION_BASE_URL=
EXTRACTION_API_KEY=
EXTRACTION_MODEL=extract
EXTRACTION_FALLBACK_ENABLED=false
EXTRACTION_PIPELINE_VERSION=fact-extraction-1
EXTRACTION_NULL_THRESHOLD=0.6

# Depose MCP server (optional, read-only)
# Bearer token clients use against /api/mcp. Minimum 24 characters.
# MCP_SERVER_FIRM_ID scopes every tool call to one firm.
MCP_SERVER_TOKEN=
MCP_SERVER_FIRM_ID=

# Worker
# Set WORKER_ENABLED=false on API replicas when a separate worker process runs
# `node dist/worker.main.js`.
WORKER_ENABLED=true
WORKER_CONCURRENCY=2

# Ingest microservice
INGEST_HOST=127.0.0.1
INGEST_PORT=4000
