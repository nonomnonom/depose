# Server
NODE_ENV=development
PORT=3000
# Serves /api/docs and /api/v1/openapi.json
OPENAPI_ENABLED=true

# Database and jobs (both required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/depose
REDIS_URL=redis://localhost:6379

# Host-based tenancy
TENANCY_MODE=single
BASE_DOMAIN=localhost
CUSTOM_DOMAIN_TARGET=
CUSTOM_DOMAIN_IP=
CUSTOM_DOMAIN_LIMIT=5
TRUST_PROXY=false
TLS_MODE=external
SSL_KEY_PATH=
SSL_CERT_PATH=

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=.local-storage

# Better Auth
# Required in production (>= 32 characters).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:5173
AUTH_SSO_ENABLED=false
AUTH_FORCE_SSO=false
AUTH_ALLOW_SELF_SIGNUP=true
AUTH_REQUIRE_ADMIN_APPROVAL=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Mail ("file" writes .eml to var/mail; "smtp" delivers)
MAIL_TRANSPORT=file
MAIL_FROM=Depose <no-reply@localhost>
MAIL_DIRECTORY=var/mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Worker
WORKER_CONCURRENCY=2

# Ingest microservice
INGEST_HOST=127.0.0.1
INGEST_PORT=4000
