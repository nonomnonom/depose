# Server
NODE_ENV=development
PORT=3000

# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/depose

# Better Auth
# Required in production; in development Better Auth can generate a secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Auth features
AUTH_SSO_ENABLED=false
AUTH_FORCE_SSO=false
AUTH_ALLOW_SELF_SIGNUP=true
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Mail ("file" writes .eml to var/mail; "smtp" delivers)
MAIL_TRANSPORT=file
MAIL_FROM=Depose <no-reply@localhost>
MAIL_DIRECTORY=var/mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Worker
WORKER_CONCURRENCY=2

# Mastra
MASTRA_PREFIX=/api/mastra
MASTRA_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=

# Retrieval (semantic search needs OPENAI_API_KEY)
VECTOR_SEARCH_ENABLED=false
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Mastra conversation memory for Q&A
MEMORY_ENABLED=true
MEMORY_LAST_MESSAGES=12

# Ingest microservice (TCP)
INGEST_HOST=127.0.0.1
INGEST_PORT=4000
