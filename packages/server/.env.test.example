# Copy to .env.test and fill in the local values.
# The E2E suite never starts containers: it creates one throwaway database per
# spec file on TEST_DATABASE_ADMIN_URL and uses an isolated Redis database.
DATABASE_URL=postgres://depose:depose@127.0.0.1:5432/depose
TEST_DATABASE_ADMIN_URL=postgres://depose:depose@127.0.0.1:5432/postgres

# Optional: use an existing database as-is instead of creating one.
# It is migrated but never dropped.
# TEST_DATABASE_URL=postgres://depose:depose@127.0.0.1:5432/depose_test

# Base Redis URL. Each spec process takes its own logical database (1-15).
REDIS_URL=redis://127.0.0.1:6379/0

# Optional: use an exact Redis server/database. It is not flushed on teardown.
# TEST_REDIS_URL=redis://127.0.0.1:6379/1

VECTOR_SEARCH_ENABLED=false
WORKER_ENABLED=true
