{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Depose modular backend server",
  "scripts": {
    "build": "node scripts/clean.mjs && node scripts/copy-templates.mjs && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "dev": "nest start",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "worker": "node dist/worker.main.js",
    "worker:dev": "nest start --watch --entryFile worker.main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "setup": "node scripts/setup-dev.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node scripts/db-reset.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@better-auth/sso": "^1.7.18",
    "@mastra/core": "^1.82.0",
    "@mastra/memory": "^1.41.0",
    "@mastra/nestjs": "^0.2.41",
    "@mastra/pg": "^1.35.0",
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.4.1",
    "@nestjs/core": "^12.4.1",
    "@nestjs/mail": "^0.0.2",
    "@nestjs/microservices": "^12.4.2",
    "@nestjs/platform-express": "^12.4.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.18",
    "bullmq": "^6.7.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "kysely": "^0.29.8",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript-eslint": "^8.0.0",
    "prettier": "3.9.6"
  }
}
