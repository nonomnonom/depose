{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Depose modular backend server",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "dev": "nest start",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --no-warn-ignored",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "check-types": "tsc --noEmit",
    "test": "node scripts/test-e2e.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:ci": "node scripts/test-e2e.mjs",
    "setup": "node scripts/setup-dev.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/migrate.js",
    "db:reset": "node scripts/db-reset.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "openapi:export": "node scripts/export-openapi.mjs"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.137",
    "@ai-sdk/anthropic": "3.0.60",
    "@ai-sdk/azure": "^4.0.121",
    "@ai-sdk/google": "3.0.60",
    "@ai-sdk/openai": "^4.0.113",
    "@ai-sdk/openai-compatible": "3.0.90",
    "@ai-sdk/typesafe-ai": "^3.0.37",
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@better-auth/sso": "^1.7.18",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/ai": "0.0.2",
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.4.1",
    "@nestjs/core": "^12.4.1",
    "@nestjs/mcp": "0.0.4",
    "@nestjs/microservices": "^12.4.2",
    "@nestjs/platform-express": "^12.4.1",
    "@nestjs/resilience": "0.0.3",
    "@nestjs/workflows": "0.0.5",
    "ai": "7.0.169",
    "better-auth": "^1.7.18",
    "bullmq": "^6.7.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "rxjs": "^7.8.2",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/testing": "^12.4.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "3.9.6",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.0.0"
  }
}